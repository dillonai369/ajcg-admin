# =================================================================
# AJ Commercial Group — environment variables
#
# 1. Copy this file:   cp .env.example .env.local
# 2. Paste your real keys below
# 3. Restart `npm run dev`
#
# IMPORTANT: .env.local is gitignored. Never commit secret keys.
# =================================================================

# -----------------------------------------------------------------
# SUPABASE (database + image storage)
# Get these from: https://app.supabase.com → your project → Settings → API
# -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-secret-key...

# -----------------------------------------------------------------
# CLERK (auth — login for Joey & Anthony)
# Get these from: https://dashboard.clerk.com → your app → API Keys
# -----------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# -----------------------------------------------------------------
# ANTHROPIC (AI-assist features in blog/listing editors)
# Get this from: https://console.anthropic.com → API Keys
# -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------
# GOHIGHLEVEL (lead relay — /api/lead forwards form submissions here)
# Inbound webhook trigger URL from GHL. Required: with it unset the relay
# fails closed and leads are only stored in the admin inbox.
# -----------------------------------------------------------------
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/.../webhook-trigger/...

# -----------------------------------------------------------------
# LEAD EMAIL ALERTS (optional — off until all three are set)
# resend.com → API key; LEAD_NOTIFY_FROM must be on a domain verified in Resend.
# -----------------------------------------------------------------
RESEND_API_KEY=re_...
LEAD_NOTIFY_TO=joey@ajcommercialgroup.com, anthony@ajcommercialgroup.com
LEAD_NOTIFY_FROM=leads@ajcommercialgroup.com
# ADMIN_BASE_URL=https://app.ajcommercialgroup.com   # link target in the email (default shown)
